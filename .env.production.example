# =============================================================================
# Sutawane Classes Management Software - Production Environment Template
# =============================================================================
# Copy to '/home/sutawane/sutawane_classes/.env' (or '.env.production') and
# set chmod 600. Never commit real secrets to Git.

# 1. Environment & Core Security
DJANGO_ENV=production
DJANGO_DEBUG=False
# Generate with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-this-to-a-strong-random-secret-key-in-production

# Authorized domains & VPS IP
DJANGO_ALLOWED_HOSTS=portal.sutawanegroup.com,sutawanegroup.com,www.sutawanegroup.com,173.249.33.152,127.0.0.1,localhost

# CSRF Trusted Origins (include https:// domains and http:// IP:port if used)
DJANGO_CSRF_TRUSTED_ORIGINS=https://portal.sutawanegroup.com,https://sutawanegroup.com,https://www.sutawanegroup.com,http://173.249.33.152:8080,http://127.0.0.1:8080

# Set True when served over HTTPS (e.g. portal.sutawanegroup.com via Nginx SSL)
DJANGO_SECURE_SSL=True

# 2. PostgreSQL Production Database
DB_NAME=sutawane_db
DB_USER=sutawane_user
DB_PASSWORD=replace-with-your-postgres-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60
DB_SSLMODE=prefer

# 3. Google SMTP Email Configuration (For Developer OTP & System Alerts)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=prameshwar4378@gmail.com
EMAIL_HOST_PASSWORD=pkppqklbhjjtbont
DEFAULT_FROM_EMAIL="Sutawane Software Support" <prameshwar4378@gmail.com>
SERVER_EMAIL=prameshwar4378@gmail.com

# 4. External Production Storage Directories (Outside code repository)
DJANGO_MEDIA_ROOT=/home/sutawane/media
DJANGO_BACKUPS_DIR=/home/sutawane/backup_zip
DJANGO_LOGS_DIR=/home/sutawane/logs

# 5. Cache (FileBasedCache shared across Gunicorn workers by default, or set REDIS_URL)
DJANGO_CACHE_BACKEND=filebased
# REDIS_URL=redis://127.0.0.1:6379/1

# 6. Production Server Port & Logging
PORT=8000
DJANGO_LOG_LEVEL=INFO
