# =============================================================================
# Sutawane Classes Management Software - Development Environment Template
# =============================================================================
# Copy this file to '.env' for local development (uses SQLite db.sqlite3).

# Environment selector ('development' | 'production')
DJANGO_ENV=development
DJANGO_DEBUG=True

# Local development secret key
DJANGO_SECRET_KEY=django-insecure-local-dev-key-change-in-production

# Local hosts
DJANGO_ALLOWED_HOSTS=*
DJANGO_SECURE_SSL=False

# Email Configuration (For Developer OTP & System Alerts)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=prameshwar4378@gmail.com
EMAIL_HOST_PASSWORD=replace-with-your-gmail-app-password
DEFAULT_FROM_EMAIL="Sutawane Software Support" <prameshwar4378@gmail.com>
SERVER_EMAIL=prameshwar4378@gmail.com

PORT=8000
