# =============================================================================
# Sutawane Classes Management Software - Environment Configuration Template
# =============================================================================
# Copy this file to '.env' and adjust the values for your production environment.

# 1. Core Security & Secret Key
# Generate a strong key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-this-to-a-strong-random-secret-key-in-production

# Set to False in production! Set to True only during local development.
DJANGO_DEBUG=False

# Comma-separated list of domain names / IP addresses authorized to serve this app.
# Example: sutawaneclasses.com,www.sutawaneclasses.com,192.168.1.100,localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=*

# Comma-separated list of trusted origins for CSRF POST requests (required for HTTPS / custom domains)
# Example: https://sutawaneclasses.com,https://www.sutawaneclasses.com,https://*.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost,https://127.0.0.1

# 2. HTTPS / SSL Enforcement (Set to True if your server has an SSL/TLS certificate)
DJANGO_SECURE_SSL=False

# 3. Google SMTP Email Configuration (For Developer OTP & System Alerts)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=prameshwar4378@gmail.com
EMAIL_HOST_PASSWORD=pkppqklbhjjtbont
DEFAULT_FROM_EMAIL="Sutawane Software Support" <prameshwar4378@gmail.com>
SERVER_EMAIL=prameshwar4378@gmail.com

# 4. Production Server Port (Used by Gunicorn / Waitress / Docker)
PORT=8000
